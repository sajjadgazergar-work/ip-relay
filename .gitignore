__pycache__/
*.pyc
.venv/
.env
*.sqlite

# Local state — contains credentials. settings.json holds the upstream and
# Webshare API keys; lanes.json holds proxy URLs including user:pass userinfo.
settings.json
lanes.json
lanes.json.tmp

# Burn memory is per-host measured state (which egress IPs this box has spent).
# Useless and misleading on another machine — every host burns its own set.
burned.json
burned.json.tmp

# Token-usage DB is the same kind of per-host live state as burned.json — it
# would drift instantly on another machine and its history is not a source file.
usage.json
usage.json.tmp

# Playwright verification screenshots — regenerate with
# tools/verify_dashboard_v10.py / tools/make_screenshots.py, don't version
# multi-MB PNGs of ephemeral UI state.
artifacts/
*.png
